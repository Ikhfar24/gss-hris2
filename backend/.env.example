# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/papaiz_hris?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# AES-256-GCM key used only for active temporary credentials. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TEMP_CREDENTIAL_KEY_VERSION="v1"
TEMP_CREDENTIAL_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
TEMP_CREDENTIAL_TTL_HOURS=24

# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Set only when the backend runs behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Explicit opt-in for local/demo seed data. Never enable in production.
ALLOW_INSECURE_DEVELOPMENT_SEED=false
